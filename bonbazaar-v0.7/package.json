{
  "name": "bonbazaar",
  "version": "0.7.0",
  "description": "BonBazaar - Digital Marketplace",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "server": "node server.js",
    "test": "node --test test"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "electron": "^28.0.0",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.bonbazaar.app",
    "productName": "BonBazaar",
    "artifactName": "BonBazaar-v${version}-Setup.${ext}",
    "files": [
      "main.js",
      "server.js",
      "monitor/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
